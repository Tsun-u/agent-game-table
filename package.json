{
  "name": "agent-game-table",
  "version": "0.1.0",
  "private": true,
  "description": "A multiplayer Big Two table where humans and MCP agents play together.",
  "type": "module",
  "bin": {
    "agent-game-table-mcp": "dist/src/index.js",
    "agent-game-table-host": "dist/src/host.js",
    "agent-game-table-remote": "dist/src/remote.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && node scripts/prepare-web.mjs && tsc -p tsconfig.json",
    "start": "npm run build && node dist/src/host.js",
    "start:remote": "npm run build && node dist/src/remote.js",
    "start:mcp": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "npm run build && node --test e2e/*.test.mjs",
    "health": "node scripts/health.mjs",
    "generate:remote-secrets": "node scripts/generate-remote-secrets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jose": "^6.2.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "lottie-web": "5.13.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
