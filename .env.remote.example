# Copy this file to .env.remote. Never commit the real file.
AGENT_GAME_TABLE_PUBLIC_URL=https://game-table.example.com
AGENT_GAME_TABLE_STATE_KEY=replace-with-32-byte-base64url-state-key
AGENT_GAME_TABLE_HUMAN_ACCESS_KEY=replace-with-at-least-32-character-management-key
AGENT_GAME_TABLE_BIND_PORT=3210
AGENT_GAME_TABLE_REMOTE_KEYS_FILE=./data/remote-keys.json
# 內建 OAuth 登入（給 claude.ai／ChatGPT connector 與 Claude Code／Codex 的 OAuth）：
# 名單是 { "email": "顯示名稱" }，通關密語大家共用；兩個一起設才會啟用。
AGENT_GAME_TABLE_MEMBERS_FILE=./data/remote-members.json
AGENT_GAME_TABLE_LOGIN_PASSPHRASE=replace-with-a-shared-passphrase
AGENT_GAME_TABLE_OAUTH_CLIENTS_PATH=./data/oauth-clients.json
